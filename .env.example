# --- LLM (optional). Leave OPENAI_API_KEY empty to run in offline demo mode (rule-based agent). ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_PORT=8080
DB_PATH=/data/onlygo.db
LOG_LEVEL=INFO
APP_TZ=Europe/Moscow
SESSION_TTL_DAYS=14
# Requests per minute per client IP on /api/*; 0 disables the limiter
RATE_LIMIT_PER_MIN=120
